rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /taskAttachments/{taskId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/tasks/$(taskId))
        && (firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.tutorUid == request.auth.uid
            || firestore.get(/databases/(default)/documents/tasks/$(taskId)).data.studentUid == request.auth.uid);
    }
    match /classAttachments/{classId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/classes/$(classId))
        && (firestore.get(/databases/(default)/documents/classes/$(classId)).data.tutorUid == request.auth.uid
            || firestore.get(/databases/(default)/documents/classes/$(classId)).data.studentUids.hasAny([request.auth.uid]));
    }
    match /profilePictures/{userId}/{allPaths=**} {
      // Anyone signed in can view an avatar; only the owner can set their own.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /qnaAttachments/{threadId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/qnaThreads/$(threadId))
        && (firestore.get(/databases/(default)/documents/qnaThreads/$(threadId)).data.tutorUid == request.auth.uid
            || firestore.get(/databases/(default)/documents/qnaThreads/$(threadId)).data.studentUid == request.auth.uid);
    }
  }
}
